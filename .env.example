# Synthetic data generator. Every key is required: the settings layer fails fast on a missing one.

# Seed for the single random generator; the same seed gives byte-identical output.
DATA_SEED=20261102
# First service date to generate (ISO date). 2026-11-02 is a Monday.
DATA_START_DATE=2026-11-02
# Number of consecutive service days to generate.
DATA_DAYS=7
# Folder with the hand-maintained master data (areas, depot, labs, fleet, names).
DATA_REFERENCE_DIR=data/reference
# Folder the generator writes its CSVs to.
DATA_OUTPUT_DIR=data/sample
# Shape of demand per vertical (durations, time windows, mixes, rates). Keys documented inside.
DEMAND_PROFILE_PATH=data/reference/demand_profile.json

# Mean bookings per day before the weekday multiplier (A13).
VOL_NURSING_PER_DAY=12
VOL_BABYSITTING_PER_DAY=10
VOL_SAMPLE_PER_DAY=40

# Staff pool sizes per role (A6).
STAFF_HOME_NURSES=16
STAFF_BABYSITTERS=14
STAFF_COLLECTION_NURSES=5

# Number of synthetic clients across all verticals.
CLIENTS_TOTAL=220
