# Synthetic data generator. Every key is required: the settings layer fails fast on a missing one.

# Seed for the single random generator; the same seed gives byte-identical output.
DATA_SEED=20261102
# First service date to generate (ISO date). 2026-11-02 is a Monday.
DATA_START_DATE=2026-11-02
# Number of consecutive service days. 30+ so hub siting and capacity have history to learn from.
DATA_DAYS=35
# Folder with the hand-maintained master data (areas, office, labs, services, fleet, names).
DATA_REFERENCE_DIR=data/reference
# Folder the generator writes its CSVs to.
DATA_OUTPUT_DIR=data/sample
# Shape of demand (hourly curve, lead times, mixes, rates). Keys documented inside.
DEMAND_PROFILE_PATH=data/reference/demand_profile.json

# Mean orders published per service day on a weekday, before the weekday multiplier (S4).
ORDERS_PER_DAY=45
# Staff pool sizes (S3). Pairs on duty = nurses and drivers available that day; keep drivers <= cars.
STAFF_NURSES=14
STAFF_DRIVERS=12

# --- Planning engine ---------------------------------------------------------------------------
# Predicted road km = straight-line km x this factor (S14).
ROAD_FACTOR=1.45
# Average road speeds, and when the peak speed applies ('HH:MM-HH:MM,...').
SPEED_KMH_OFF_PEAK=45
SPEED_KMH_PEAK=28
PEAK_WINDOWS=07:00-09:30,16:00-19:00
# A pair must arrive within +/- this many minutes of the requested slot (S9).
ARRIVAL_TOLERANCE_MIN=15
# Minutes between arriving and starting the service: parking, reaching the door.
ACCESS_MIN=5
# Minutes at the office to collect IV kits that were not prepared in advance (S12).
OFFICE_SUPPLY_STOP_MIN=10
# Planned on-site time = service minimum + this fraction of (maximum - minimum).
PLAN_DURATION_POSITION=0.5
# Shift length, and the start times a placeholder roster cycles over (until PLAN step 5).
SHIFT_HOURS=12
ROSTER_SHIFT_STARTS=05:30,08:00,10:00
# An idle gap shorter than this is waited out in place instead of going to a standby spot.
STANDBY_MIN_GAP_MIN=20

# --- Roster auto-allocation --------------------------------------------------------------------
# Demand is sized in pair-hours: each expected order takes its planned service time, the access time
# and this much driving; a pair should spend this share of an on-duty hour working.
ROSTER_TRAVEL_ALLOWANCE_MIN=30
ROSTER_TARGET_UTILISATION=0.6
# The roster picks each pair's shift start between these times, on this grid.
ROSTER_START_EARLIEST=05:30
ROSTER_START_LATEST=10:00
ROSTER_START_STEP_MIN=30
# A pair must already be on duty this many minutes before the slot it serves (time to reach the patient),
# so demand is counted this much earlier than the slot. Between 0 and 60.
ROSTER_LEAD_MIN=30
# An hour with at least this many expected orders keeps at least this many pairs on duty, however small
# its demand, because an hour nobody covers loses every order in it.
ROSTER_MIN_ORDERS_FOR_COVER=0.15
ROSTER_MIN_PAIRS_WHEN_BOOKED=1

# --- Acceptance and replay ---------------------------------------------------------------------
# Seed for the replay's own random draws (response delays).
REPLAY_SEED=7
# When ops are at their desks to accept orders.
OFFICE_HOURS=08:00-20:00
# Overnight hours that do not count when judging whether ops have time to react (may wrap midnight).
QUIET_HOURS=22:00-06:00
# The tool accepts an order by itself when its lead time, quiet hours excluded, is at least this many hours.
AUTO_ACCEPT_LEAD_H=12
# Excel era: minutes from ops first seeing an order (office hours only) to deciding on it (S15).
EXCEL_RESPONSE_MIN_LO=15
EXCEL_RESPONSE_MIN_HI=90
# With the tool: orders it does not accept itself still go to ops, who see the open slots upfront.
MANUAL_RESPONSE_MIN_LO=5
MANUAL_RESPONSE_MIN_HI=30

# --- Web app -----------------------------------------------------------------------------------
# Where the API listens (valeo-serve), the built UI it serves at /, and the dev server allowed to call it.
API_HOST=127.0.0.1
API_PORT=8000
WEB_DIST_DIR=web/dist
DEV_CORS_ORIGIN=http://localhost:5173
